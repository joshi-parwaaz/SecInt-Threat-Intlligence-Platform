# SecInt v2 - Environment Configuration
# =====================================================================
# LOCAL DEVELOPMENT
# =====================================================================
# 1. cp .env.example .env
# 2. Fill in values below
# 3. Never commit .env to git (already in .gitignore)
#
# PRODUCTION (Render + Vercel)
# =====================================================================
# Set these as environment variables in the Render dashboard.
# DO NOT put real secrets in this file.
# =====================================================================

# ── Threat Intelligence API Keys ─────────────────────────────────────
# Without these the app runs in demo mode (seeded fixture data).
# With any one key present, live data is fetched and demo data is cleared.

# AlienVault OTX  →  https://otx.alienvault.com/api
OTX_API_KEY=

# AbuseIPDB  →  https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=

# VirusTotal  →  https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# URLhaus (optional — public API works without a key)
URLHAUS_API_KEY=

# ── Database ─────────────────────────────────────────────────────────
# MongoDB Atlas free tier (512 MB forever):
#   1. Create cluster at https://cloud.mongodb.com
#   2. Network Access → Allow from anywhere (0.0.0.0/0)
#   3. Database Access → create user
#   4. Connect → Drivers → copy connection string
#
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/secint?retryWrites=true&w=majority

# ── CORS ─────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:3000

# ── Scheduler ────────────────────────────────────────────────────────
# How often (in hours) to auto-refresh IOCs from threat feeds.
REFRESH_INTERVAL_HOURS=6

# ── Frontend (React) ─────────────────────────────────────────────────
# Set in Vercel dashboard under Environment Variables.
REACT_APP_API_URL=http://localhost:8000

# ── Misc ─────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
